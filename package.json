{
  "name": "@mfe/source",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start": "npm run start:all",
    "start:shell": "rsbuild dev --config apps/app-shell/rsbuild.config.ts",
    "rsbuild:shell": "rsbuild dev --config apps/app-shell/rsbuild.config.ts",
    "rsbuild:build:shell": "rsbuild build --config apps/app-shell/rsbuild.config.ts",
    "rsbuild:auth": "rsbuild dev --config apps/mfe-auth/rsbuild.config.ts",
    "rsbuild:build:auth": "rsbuild build --config apps/mfe-auth/rsbuild.config.ts",
    "rsbuild:dashboard": "rsbuild dev --config apps/mfe-dashboard/rsbuild.config.ts",
    "rsbuild:build:dashboard": "rsbuild build --config apps/mfe-dashboard/rsbuild.config.ts",
    "rsbuild:reporting": "rsbuild dev --config apps/mfe-reporting/rsbuild.config.ts",
    "rsbuild:build:reporting": "rsbuild build --config apps/mfe-reporting/rsbuild.config.ts",
    "start:backend": "cd backend && npm run dev",
    "start:all": "concurrently -k -n \"BACKEND,AUTH,DASHBOARD,REPORTING,SHELL\" -c \"bgBlue.bold,bgYellow.bold,bgGreen.bold,bgMagenta.bold,bgCyan.bold\" \"npm:start:backend\" \"npm:rsbuild:auth\" \"npm:rsbuild:dashboard\" \"npm:rsbuild:reporting\" \"npm:rsbuild:shell\"",
    "build": "nx affected -t build --parallel=4",
    "build:lib": "nx build core && nx build ui",
    "test": "nx run-many -t test"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "~19.2.0",
    "@angular/animations": "~19.2.0",
    "@angular/cdk": "^19.2.0",
    "@angular/common": "~19.2.0",
    "@angular/compiler": "~19.2.0",
    "@angular/core": "~19.2.0",
    "@angular/forms": "~19.2.0",
    "@angular/material": "^19.2.0",
    "@angular/platform-browser": "~19.2.0",
    "@angular/platform-browser-dynamic": "~19.2.0",
    "@angular/platform-server": "~19.2.0",
    "@angular/router": "~19.2.0",
    "@angular/ssr": "~19.2.0",
    "@ngrx/signals": "^19.2.1",
    "rxjs": "~7.8.0",
    "tds-ui": "https://tds.tmtco.org/lib/tds-ui-18.6.2.tgz",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~19.2.0",
    "@angular-devkit/schematics": "~19.2.0",
    "@angular/cli": "~19.2.0",
    "@angular/compiler-cli": "~19.2.0",
    "@angular/language-service": "~19.2.0",
    "@eslint/js": "^9.8.0",
    "@module-federation/enhanced": "^2.8.0",
    "@ng-rsbuild/plugin-angular": "^21.0.4",
    "@nx/angular": "21.2.0",
    "@nx/devkit": "21.2.0",
    "@nx/eslint": "21.2.0",
    "@nx/eslint-plugin": "21.2.0",
    "@nx/jest": "21.2.0",
    "@nx/js": "21.2.0",
    "@nx/module-federation": "21.2.0",
    "@nx/web": "21.2.0",
    "@nx/workspace": "21.2.0",
    "@rsbuild/core": "^1.1.14",
    "@rspack/cli": "^1.7.12",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/jest": "~29.5.12",
    "@types/node": "^20.14.9",
    "concurrently": "^10.0.4",
    "eslint": "^9.8.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~29.7.0",
    "jest-preset-angular": "^14.1.1",
    "nx": "21.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.1.5",
    "ts-node": "10.9.1",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "allowScripts": {
    "@swc/core@1.15.47": true
  },
  "overrides": {
    "tds-ui": {
      "@angular/cdk": "$@angular/cdk",
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/forms": "$@angular/forms",
      "@angular/router": "$@angular/router"
    }
  }
}
