            "main": "apps/mfe-auth/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "apps/mfe-auth/tsconfig.app.json",
            "assets": ["apps/mfe-auth/src/assets"],
            "styles": ["apps/mfe-auth/src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules"]
            },
            "customWebpackConfig": {
              "path": "apps/mfe-auth/webpack.config.ts"
            }
          }
        },
        "serve": {
          "builder": "@nx/angular:dev-server",
          "options": {
            "buildTarget": "mfe-auth:build",
            "port": 4201,
            "liveReload": false,
            "hmr": false
          }
        }
      }
    },
    "mfe-dashboard": {
