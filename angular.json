{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "app-shell": {
      "projectType": "application",
      "root": "apps/app-shell",
      "sourceRoot": "apps/app-shell/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@nx/angular:webpack-browser",
          "options": {
            "outputPath": "dist/apps/app-shell",
            "index": "apps/app-shell/src/index.html",
            "main": "apps/app-shell/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "apps/app-shell/tsconfig.app.json",
            "assets": ["apps/app-shell/src/assets"],
            "styles": ["apps/app-shell/src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules"]
            },
            "customWebpackConfig": {
              "path": "apps/app-shell/webpack.config.ts"
            }
          }
        },
        "serve": {
          "builder": "@nx/angular:dev-server",
          "options": {
            "buildTarget": "app-shell:build",
            "port": 4200,
            "liveReload": false,
            "hmr": false
          }
        }
      }
    },
    "mfe-auth": {
      "projectType": "application",
      "root": "apps/mfe-auth",
      "sourceRoot": "apps/mfe-auth/src",
      "prefix": "app",
